# ═══════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES - FOR LOCAL DEVELOPMENT ONLY
# ═══════════════════════════════════════════════════════════════════
#
# ⚠️  DO NOT USE .env FILE IN PRODUCTION
#     PhalaCloud doesn't support .env files
#     All config must be in docker-compose.yml
#
# For local development without Docker:
#   1. Copy this file to .env
#   2. Update the values as needed
#   3. Run: npm run dev
#
# For production (Docker/PhalaCloud):
#   Configure in docker-compose.yml environment section
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL Database Connection
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:yayasan_kasi_2024@localhost:5432/yayasan_kasi?schema=public"

# Server Configuration
PORT=3000
NODE_ENV=development

# Upload Settings (optional)
MAX_FILE_SIZE=10485760
IMAGE_QUALITY=85
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080
