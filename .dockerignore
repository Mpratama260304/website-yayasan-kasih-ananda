# ═══════════════════════════════════════════════════════════════════
# DOCKERIGNORE - Yayasan Kasih Ananda CMS
# ═══════════════════════════════════════════════════════════════════
# Exclude unnecessary files from Docker build context
# ═══════════════════════════════════════════════════════════════════

# Dependencies (will be installed fresh)
node_modules
.npm

# Build output (will be built in container)
dist

# Development files
.git
.gitignore
.vscode
.idea
*.log
*.md
!README.md

# Environment files (should be provided separately)
.env
.env.*
!.env.example
!.env.production

# Docker files (not needed inside container)
Dockerfile
docker-compose*.yml
.dockerignore

# OS files
.DS_Store
Thumbs.db

# Test files
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__
coverage

# Temporary files
tmp
temp
*.tmp
*.temp

# Upload files (mounted as volume)
uploads/*
!uploads/.gitkeep

# Logs
logs
*.log
npm-debug.log*

# Editor directories
.vscode
.idea
*.swp
*.swo

# Build artifacts
.tsbuildinfo
